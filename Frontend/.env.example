# ── MYNE frontend ─────────────────────────────────────────────────────────────
# Copy to .env and fill in. Everything here ships to the browser — only ever put
# public values in a VITE_ var. The Supabase SERVICE_ROLE key must NEVER appear
# in this file; it belongs in backend/.env alone.

# Supabase project (chat, profiles, follows, news).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon/publishable key. Public by design — RLS and Edge Functions enforce
# every write, so this key alone grants read-only access.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Express social backend (reactions, avatars, follows, news). Vite proxies to it.
VITE_SOCIAL_API=http://127.0.0.1:4030

# Product identity. These defaults can be changed without editing application code.
VITE_PRODUCT_NAME=MYNE
VITE_TOKEN_NAME=MYNE
VITE_TOKEN_SYMBOL=MYNE

# Solana network. Use mainnet-beta only after every program has been deployed and audited.
VITE_SOLANA_CLUSTER=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_SOLANA_EXPLORER_URL=https://explorer.solana.com

# The program address is fixed by Anchor.toml and the checked-in deploy keypair. Setting it
# activates the protocol adapter; leave it blank only for static preview mode.
VITE_MYNE_PROGRAM_ID=D6kkupmJWw9bpDZ46R8Xn1ncMtC1upopPo2wundvWd3e
# Populate the public mint address printed by devnet:initialize after guarded initialization.
VITE_MYNE_MINT_ADDRESS=
VITE_MYNE_RANDOMNESS_PROGRAM_ID=
VITE_MYNE_UPGRADE_AUTHORITY=
VITE_MYNE_INDEXER_URL=

# Optional public community links. Leave empty rather than publishing stale handles.
VITE_TELEGRAM_URL=
VITE_X_URL=
